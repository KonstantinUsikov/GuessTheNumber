<Window x:Class="WpfAppClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppClient"
        mc:Ignorable="d"
        Title="Клиент" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="&quot;Угадай число&quot;" 
               FontSize="30" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
               Content="Введите IP:port" 
               FontSize="15" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"/>

            <TextBox x:Name="textBoxIp"
               Text="127.0.0.1:8080" 
               Grid.Column="1"
               FontSize="15" 
               VerticalContentAlignment="Center"
               Height="30"
               Padding="5,0,5,0"
               Margin="5,5,15,5"/>

            <Button x:Name="buttonConnect"
               Grid.Column="2"
               Content="Подключиться" 
               FontSize="20" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"
               Height="40"
               Margin="5,5,5,5" Click="buttonConnect_Click"/>

        </Grid>

        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="0.65*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
               Content="Выберите диапазон" 
               FontSize="15" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"/>
            
            <Label Grid.Column="1"
               Content="Минимум:" 
               FontSize="15" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"/>

            <TextBox x:Name="textBoxMin"
               Text="0" 
               Grid.Column="2"
               FontSize="15" 
               VerticalContentAlignment="Center"
               Height="30"
               Padding="5,0,5,0"
               Margin="5,5,15,5" 
               IsEnabled="False"
               TextChanged="textBoxMin_TextChanged"/>

            <Label Grid.Column="3"
               Content="Максимум:" 
               FontSize="15" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"/>

            <TextBox x:Name="textBoxMax"
               Grid.Column="4"
               Text="100" 
               FontSize="15" 
               VerticalContentAlignment="Center"
               Height="30"
               Padding="5,0,5,0"
               Margin="5,5,15,5" 
               IsEnabled="False"
               TextChanged="textBoxMax_TextChanged"/>

            <Button x:Name="buttonStart"
               Grid.Column="5"
               Content="Начать" 
               FontSize="20" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center"
               Height="40"
               Margin="10,20,10,25" 
               IsEnabled="False"
               Click="buttonStart_Click"/>

        </Grid>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                    Content="Ваш выбор" 
                    FontSize="20" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"/>

                <TextBox Grid.Row="1"
                    x:Name="textBoxGuess"
                    Grid.Column="4"
                    FontSize="15" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    Height="50"
                    IsEnabled="False"
                    Margin="10,5,10,5" TextChanged="textBoxGuess_TextChanged"/>

                <Button x:Name="buttonGuess" 
                    Grid.Row="2"
                    Content="Отправить" 
                    FontSize="15" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    IsEnabled="False"
                    Margin="10,10,10,10" Click="buttonGuess_Click"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                    Content="Больше чем" 
                    FontSize="20" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"/>

                <TextBox x:Name="textBoxMoreThan"
                    Grid.Row="1" 
                    TextWrapping="Wrap" 
                    Text="" 
                    HorizontalContentAlignment="Left" 
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto" 
                    HorizontalScrollBarVisibility="Auto" 
                    AcceptsReturn="True" 
                    AcceptsTab="True"
                    FontSize="20" 
                    Margin="5,5,5,5" 
                    Padding="5"
                    IsReadOnly="True"
                    />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                    Content="Меньше чем" 
                    FontSize="20" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"/>

                <TextBox x:Name="textBoxLessThan"
                    Grid.Row="1" 
                    TextWrapping="Wrap" 
                    Text="" 
                    HorizontalContentAlignment="Left" 
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto" 
                    HorizontalScrollBarVisibility="Auto" 
                    AcceptsReturn="True" 
                    AcceptsTab="True"
                    FontSize="20" 
                    Margin="5,5,5,5" 
                    Padding="5"
                    IsReadOnly="True"
                    />
            </Grid>
        </Grid>
    </Grid>
</Window>
